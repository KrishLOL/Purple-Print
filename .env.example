# Any reachable Postgres works. See README.md#database — a free Neon branch is what this
# project develops against; `postgresql://weu:weu@localhost:5432/...` is the Docker fallback.
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require"

# --- Auth.js (magic link, @uwo.ca only) ---
AUTH_SECRET="generate-a-real-secret-with-openssl-rand-base64-32"
AUTH_EMAIL_FROM="no-reply@your-domain.com"
AUTH_EMAIL_SERVER="smtp://user:pass@smtp-host:587"
NEXTAUTH_URL="http://localhost:3000"

# --- Site — used for the sitemap, OG images, and JSON-LD ---
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
