// Prisma schema for Purpleprint
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Term {
  FALL
  WINTER
  SUMMER
}

enum GradeBucket {
  A
  B
  C
  D
  F
  PREFER_NOT_TO_SAY
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REMOVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  DEFAMATION
  PERSONAL_INFO
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum Role {
  STUDENT
  MOD
  ADMIN
}

// ---------------------------------------------------------------------------
// Core catalog
// ---------------------------------------------------------------------------

model Discipline {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  code        String  @unique
  blurb       String
  colorAccent String
  glyphKey    String

  // Combined/concurrent degrees (e.g. AISE, Biomedical Engineering) layer
  // extra dedicated courses on top of a base discipline rather than
  // replacing it — kept separate so the homepage can group them apart
  // from the seven core disciplines + First Year.
  isCombinedDegree Boolean @default(false)

  courses     Course[]
  professors  Professor[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id            String @id @default(cuid())
  code          String @unique
  title         String
  description   String

  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])

  yearLevel          Int
  termsOffered       Term[]
  isCore             Boolean @default(true)
  isFirstYearCommon  Boolean @default(false)

  antirequisites String?
  prerequisites  String?

  // Set only when this exact course has no literal Summer section, but the
  // calendar's own antirequisite/prerequisite text names a real accepted
  // substitute from a different (often non-engineering) department -- e.g.
  // NMM 1412A has no Summer offering, but Calculus 1000A/B, an antirequisite
  // of it, does. Null means "no such note," not "not offered in summer" --
  // that's what termsOffered is for.
  summerEquivalentNote String?

  // denormalized aggregates, recomputed on review write inside lib/ratings.ts
  reviewCount  Int   @default(0)
  avgUseful    Float @default(0)
  avgEasy      Float @default(0)
  avgLiked     Float @default(0)
  avgWorkload  Float @default(0)

  isSeedData Boolean @default(false)

  professors CourseProfessor[]
  reviews    Review[]
  savedBy    SavedCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disciplineId])
  @@index([yearLevel])
}

model Professor {
  id          String @id @default(cuid())
  firstName   String
  lastName    String
  slug        String @unique
  title       String
  profileUrl  String?

  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])

  // placeholder for a future claim/response flow
  hasResponded Boolean @default(false)

  // denormalized aggregates, recomputed on review write inside lib/ratings.ts
  reviewCount    Int   @default(0)
  avgClarity     Float @default(0)
  avgHelpfulness Float @default(0)
  avgRetakePct   Float @default(0)
  avgRating      Float @default(0)

  isSeedData Boolean @default(false)

  courses CourseProfessor[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disciplineId])
}

model CourseProfessor {
  id             String @id @default(cuid())
  courseId       String
  professorId    String
  lastTaughtTerm String?

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([courseId, professorId])
  @@index([professorId])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  emailHash   String
  emailDomain String

  // Required by the Auth.js Prisma adapter's User model shape. Never
  // populated or shown in the UI — reviews are anonymized via discipline +
  // grad year (see lib/anonymize.ts), never a name.
  name          String?
  image         String?
  emailVerified DateTime?

  disciplineId       String?
  discipline         Discipline? @relation(fields: [disciplineId], references: [id])
  gradYear           Int?
  hasOnboarded       Boolean     @default(false)

  role     Role    @default(STUDENT)
  isBanned Boolean @default(false)

  isSeedData Boolean @default(false)

  accounts        Account[]
  sessions        Session[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  reviewReports   ReviewReport[]
  moderationLogs  ModerationLog[]
  savedCourses    SavedCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auth.js (magic-link email only — no OAuth providers, but the adapter's
// generic schema still expects an Account model to exist)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Backs the sign-in flow's code-entry step. Two link-based approaches
// (a plain magic link, then one gated behind a confirm-page click, then
// one behind an opaque id instead of a `?url=` param) were each defeated
// in turn by whatever scans uwo.ca mail (Microsoft 365/Defender) --
// confirmed live, step by step against this database, that the real
// token was being consumed at mail-delivery time, before the user had
// even opened the message, regardless of how the link itself was shaped.
//
// A link is fundamentally the wrong primitive here: anything reachable by
// an HTTP GET can be visited by something other than the user. A 6-digit
// code emailed as plain text has no such surface -- it isn't a URL, isn't
// clickable, and can only be "used" by a human reading it and typing it
// into a form. targetUrl holds the real (token-bearing) Auth.js callback
// URL, fetched server-to-server once the code is verified -- see
// verifySignInCode in app/auth/actions.ts.
model SignInCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  targetUrl String
  attempts  Int      @default(0)
  expires   DateTime
  createdAt DateTime @default(now())

  // Only ever populated outside production (see lib/mailer.ts) -- dev mode
  // already skips real email sending and logs the plaintext code to the
  // console instead (same as the old magic-link URL did), so this isn't a
  // new category of exposure, just making that existing dev convenience
  // something e2e tests can read deterministically instead of scraping
  // console output. codeHash (not this) is what's ever checked against.
  devCode String?

  @@index([email])
}

// Shared rate-limit counters. A serverless deploy runs many isolated
// function instances with no shared memory, so an in-memory Map (the
// original implementation) tracks each instance's own counts independently
// and under-enforces limits in production. One row per rate-limit key
// (e.g. "code-send:1.2.3.4"), reset each time its fixed window rolls over.
// See lib/rate-limit.ts.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  termTaken Term
  yearTaken Int

  useful  Int
  easy    Int
  liked   Boolean

  workloadHours Int

  // professor-specific, null when no professor selected
  clarity      Int?
  helpfulness  Int?
  wouldRetake  Boolean?

  gradeReceived GradeBucket

  body   String
  status ReviewStatus @default(PENDING)

  helpfulCount Int @default(0)
  reportCount  Int @default(0)

  isSeedData Boolean @default(false)

  votes   ReviewVote[]
  reports ReviewReport[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([professorId])
  @@index([status])
}

model ReviewVote {
  id       String @id @default(cuid())
  reviewId String
  userId   String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model SavedCourse {
  id       String @id @default(cuid())
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model ReviewReport {
  id       String @id @default(cuid())
  reviewId String
  userId   String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason  ReportReason
  details String?
  status  ReportStatus @default(OPEN)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([status])
}

model ModerationLog {
  id       String @id @default(cuid())
  actorId  String
  actor    User   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  reason     String

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
}
